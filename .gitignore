
# Python bytecode from running the skill scripts locally
__pycache__/
*.pyc

# uv virtual environment (see pyproject.toml)
.venv/

# project-local tools (Hugo binary + cache, build output) and Hugo's generated resources
.tools/
resources/

# SEO workspace (seo/) and the GSC MCP config (.mcp.json) are committed. Never commit credentials
# or bulk exports: the OAuth client lives in ~/.config/gsc/, outside this repo.
client_secrets*.json
token.json
seo/raw/

# Planner scratch (skeleton briefs, reviewer views, review rounds). The final plans/<slug>/post.*.json are committed.
plans/*/work/
