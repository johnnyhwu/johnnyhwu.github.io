0\"  \u003e\u003c/a\u003e 和 \u003ca href=\"../theme-documentation-basics#site-configuration\" rel=\"\"\u003e网站配置\u003c/a\u003e 中的 \u003ccode\u003eparams.page.seo\u003c/code\u003e 部分相同.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003eoutdatedArticleReminder\u003c/strong\u003e: \u003ca href=\"https://github.com/HEIGE-PCloud/DoIt/releases/tag/v0.2.13\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg class=\"version\"  src='/svg/version/0.2.13-new.zh-tw.min.svg'   alt=\"DoIt 新增 | 0.2.13\"  \u003e\u003c/a\u003e 和 \u003ca href=\"../theme-documentation-basics#site-configuration\" rel=\"\"\u003e网站配置\u003c/a\u003e 中的 \u003ccode\u003eparams.page.outdatedArticleReminder\u003c/code\u003e 部分相同.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003esponsor\u003c/strong\u003e: \u003ca href=\"https://github.com/HEIGE-PCloud/DoIt/releases/tag/v0.2.13\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg class=\"version\"  src='/svg/version/0.2.13-new.zh-tw.min.svg'   alt=\"DoIt 新增 | 0.2.13\"  \u003e\u003c/a\u003e 和 \u003ca href=\"../theme-documentation-basics#site-configuration\" rel=\"\"\u003e网站配置\u003c/a\u003e 中的 \u003ccode\u003eparams.sponsor\u003c/code\u003e 部分相同.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e\u003cstrong\u003erelated\u003c/strong\u003e: \u003ca href=\"https://github.com/HEIGE-PCloud/DoIt/releases/tag/v0.2.14\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg class=\"version\"  src='/svg/version/0.2.14-new.zh-tw.min.svg'   alt=\"DoIt 新增 | 0.2.14\"  \u003e\u003c/a\u003e 和 \u003ca href=\"../theme-documentation-basics#site-configuration\" rel=\"\"\u003e网站配置\u003c/a\u003e 中的 \u003ccode\u003eparams.page.related\u003c/code\u003e 部分相同.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"details admonition tip open\"\u003e\n    \u003cdiv class=\"details-summary admonition-title\"\u003e\n        \u003cspan class=\"icon\"\u003e\u003csvg class=\"icon\"\n 