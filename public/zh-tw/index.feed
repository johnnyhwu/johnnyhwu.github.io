T License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-9\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"k\"\u003e@import\u003c/span\u003e \u003cspan class=\"sx\"\u003eurl(\u0026#39;https://fonts.googleapis.com/css?family=Fira+Mono:400,700\u0026amp;display=swap\u0026amp;subset=latin-ext\u0026#39;)\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nv\"\u003e$code-font-family\u003c/span\u003e\u003cspan class=\"o\"\u003e:\u003c/span\u003e \u003cspan class=\"n\"\u003eFira\u003c/span\u003e \u003cspan class=\"n\"\u003eMono\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eSource\u003c/span\u003e \u003cspan class=\"n\"\u003eCode\u003c/span\u003e \u003cspan class=\"n\"\u003ePro\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eMenlo\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eConsolas\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eMonaco\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"ni\"\u003emonospace\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e在 \u003ccode\u003eassets/css/_custom.scss\u003c/code\u003e 中, 你可以添加一些 CSS 样式代码以自定义样式.\u003c/p\u003e\n\u003ch2 id=\"多语言和-i18n\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%a4%9a%e8%af%ad%e8%a8%80%e5%92%8c-i18n\" class=\"header-mark\"\u003e\u003c/a\u003e4 多语言和 i18n\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eDoIt\u003c/strong\u003e 主题完全兼容 Hugo 的多语言模式, 并且支持在网页上切换语言.\u003c/p\u003e\n\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/theme-documentation-basics/language-switch.gif\" title=\"\" data-thumbnail=\"/theme-documentation-basics/language-switch.gif\" data-sub-html=\"\u003ch2\u003e语言切换\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src='/theme-documentation-basics/language-switch.gif' srcset=\"/theme-documentation-basics/language-switch_hu_40b23fdb2e20dcee.webp 800w, /theme-documentation-basics/language-switch_hu_45614299688229b4.webp 1200w, /theme-documentation-basics/language-switch_hu_4f91561995443ff3.webp 1600w\"   height=\"226\" width=\"770\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e语言切换\u003c/figcaption\u003e\n    \u003c/figure\u003e\n\u003ch3 id=\"language-compatibility\" class=\"headerLink\"\u003e\n    \u003ca href=\"#language-compatibility\" class=\"header-mark\"\u003e\u003c/a\u003e4.1 兼容性\u003c/h3\u003e\u003ca href=\"https://github.com/HEIGE-PCloud/DoIt/releases/tag/v0.2.10\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg class=\"version\"  src='/svg/version/0.2.10-changed.zh-tw.min.svg'   alt=\"DoIt 更改 | 0.2.10\"  \u003e\u003c/a\u003e\n\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: left\"\u003e语言\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003eHugo 代码\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003eHTML \u003ccode\u003elang\u003c/code\u003e 属性\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003e主题文档\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e英语\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003ccode\u003een\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003ccode\u003een\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M400 32H48C21.49 32 0 53.49 0 80v352c0 26.51 21.49 48 48 48h352c26.51 0 48-21.49 48-48V80c0-26.51-21.49-48-48-48zm0 400H48V80h352v352zm-35.864-241.724L191.547 361.48c-4.705 4.667-12.303 4.637-16.97-.068l-90.781-91.516c-4.667-4.705-4.637-12.303.069-16.971l22.719-22.536c4.705-4.667 12.303-4.637 16.97.069l59.792 60.277 141.352-140.216c4.705-4.667 12.303-4.637 16.97.068l22.536 22.718c4.667 4.706 4.637 12.304-.068 16.971z\"/\u003e\u003c/svg\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e简体中文\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003ccode\u003ezh-cn\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003ccode\u003ezh-CN\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: S