 SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-9\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"k\"\u003e@import\u003c/span\u003e \u003cspan class=\"sx\"\u003eurl(\u0026#39;https://fonts.googleapis.com/css?family=Fira+Mono:400,700\u0026amp;display=swap\u0026amp;subset=latin-ext\u0026#39;)\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nv\"\u003e$code-font-family\u003c/span\u003e\u003cspan class=\"o\"\u003e:\u003c/span\u003e \u003cspan class=\"n\"\u003eFira\u003c/span\u003e \u003cspan class=\"n\"\u003eMono\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eSource\u003c/span\u003e \u003cspan class=\"n\"\u003eCode\u003c/span\u003e \u003cspan class=\"n\"\u003ePro\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eMenlo\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eConsolas\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"n\"\u003eMonaco\u003c/span\u003e\u003cspan class=\"o\"\u003e,\u003c/span\u003e \u003cspan class=\"ni\"\u003emonospace\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003eIn \u003ccode\u003eassets/css/_custom.scss\u003c/code\u003e, you can add some css style code to customize the style.\u003c/p\u003e\n\u003ch2 id=\"multilingual-and-i18n\" class=\"headerLink\"\u003e\n    \u003ca href=\"#multilingual-and-i18n\" class=\"header-mark\"\u003e\u003c/a\u003e4 Multilingual and i18n\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eDoIt\u003c/strong\u003e theme is fully compatible with Hugo multilingual mode, which provides in-browser language switching.\u003c/p\u003e\n\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/paper-intro/theme-documentation-basics/language-switch.gif\" title=\"\" data-thumbnail=\"/paper-intro/theme-documentation-basics/language-switch.gif\" data-sub-html=\"\u003ch2\u003eLanguage Switch\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src='/paper-intro/theme-documentation-basics/language-switch.gif' srcset=\"/paper-intro/theme-documentation-basics/language-switch_hu_40b23fdb2e20dcee.webp 800w, /paper-intro/theme-documentation-basics/language-switch_hu_45614299688229b4.webp 1200w, /paper-intro/theme-documentation-basics/language-switch_hu_4f91561995443ff3.webp 1600w\"   height=\"226\" width=\"770\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eLanguage Switch\u003c/figcaption\u003e\n    \u003c/figure\u003e\n\u003ch3 id=\"language-compatibility\" class=\"headerLink\"\u003e\n    \u003ca href=\"#language-compatibility\" class=\"header-mark\"\u003e\u003c/a\u003e4.1 Compatibility\u003c/h3\u003e\u003ca href=\"https://github.com/HEIGE-PCloud/DoIt/releases/tag/v0.2.10\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg class=\"version\"  src='/svg/version/0.2.10-changed.en.min.svg'   alt=\"DoIt CHANGED | 0.2.10\"  \u003e\u003c/a\u003e\n\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: left\"\u003eLanguage\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003eHugo Code\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003eHTML \u003ccode\u003elang\u003c/code\u003e Attribute\u003c/th\u003e\n            \u003cth style=\"text-align: center\"\u003eTheme Docs\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eEnglish\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003ccode\u003een\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003ccode\u003een\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: center\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M400 32H48C21.49 32 0 53.49 0 