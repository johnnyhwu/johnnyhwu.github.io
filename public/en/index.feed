row\u003e\u003cmi mathvariant=\"normal\"\u003eC\u003c/mi\u003e\u003cmover\u003e\u003cmo stretchy=\"true\" minsize=\"3.0em\"\u003e→\u003c/mo\u003e\u003cmpadded width=\"+0.6em\" lspace=\"0.3em\"\u003e\u003cmrow\u003e\u003c/mrow\u003e\u003c/mpadded\u003e\u003c/mover\u003e\u003cmn\u003e2\u003c/mn\u003e\u003cmtext\u003e \u003c/mtext\u003e\u003cmrow\u003e\u003cmi mathvariant=\"normal\"\u003eC\u003c/mi\u003e\u003cmi mathvariant=\"normal\"\u003eO\u003c/mi\u003e\u003c/mrow\u003e\u003c/mrow\u003e\u003cannotation encoding=\"application/x-tex\"\u003e \\ce{CO2 + C -\u0026gt; 2 CO} \u003c/annotation\u003e\u003c/semantics\u003e\u003c/math\u003e\u003c/span\u003e\u003cspan class=\"katex-html\" aria-hidden=\"true\"\u003e\u003cspan class=\"base\"\u003e\u003cspan class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"\u003e\u003c/span\u003e\u003cspan class=\"mord\"\u003e\u003cspan class=\"mord\"\u003e\u003cspan class=\"mord mathrm\"\u003eCO\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"mord\"\u003e\u003cspan class=\"mord\"\u003e\u003cspan class=\"mord rlap\"\u003e\u003cspan class=\"inner\"\u003e\u003cspan class=\"mord\" style=\"color:transparent;\"\u003e\u003cspan class=\"mord mathnormal\" style=\"margin-right:0.07847em;color:transparent;\"\u003eX\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"fix\"\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"msupsub\"\u003e\u003cspan class=\"vlist-t vlist-t2\"\u003e\u003cspan class=\"vlist-r\"\u003e\u003cspan class=\"vlist\" style=\"height:-0.15em;\"\u003e\u003cspan style=\"top:-2.55em;margin-right:0.05em;\"\u003e\u003cspan class=\"pstrut\" style=\"height:2.7em;\"\u003e\u003c/span\u003e\u003cspan class=\"sizing reset-size6 size3 mtight\"\u003e\u003cspan class=\"mord mtight\"\u003e\u003cspan class=\"mord mtight\"\u003e\u003cspan class=\"vlist-t\"\u003e\u003cspan class=\"vlist-r\"\u003e\u003cspan class=\"vlist\" style=\"height:0em;\"\u003e\u003cspan style=\"top:-2.7em;\"\u003e\u003cspa