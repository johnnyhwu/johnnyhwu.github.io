ation-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"s\"\u003e```wavedrom\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"s\"\u003e\u003c/span\u003e{signal: [\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  {name: \u0026#39;clock\u0026#39;,   wave: \u0026#39;p................\u0026#39;},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  {name: \u0026#39;hwrite\u0026#39;,  wave: \u0026#39;x0x.0x..0.x.0.x..\u0026#39;},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  {name: \u0026#39;htrans\u0026#39;,  wave: \u0026#39;x3x.4x..5.x.6.x..\u0026#39;, data: \u0026#39;2 2 2 2\u0026#39;},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  {name: \u0026#39;haddr\u0026#39;,   wave: \u0026#39;x3x.4x..5.x.6.x..\u0026#39;, data: \u0026#39;A0 A1 A2 A3\u0026#39;},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  {},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  {name: \u0026#39;hready\u0026#39;,  wave: \u0026#39;x1.x101x01.x0101x\u0026#39;},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  {name: \u0026#39;hrdata\u0026#39;,  wave: \u0026#39;x.3x..4x..5x...6x\u0026#39;, data: \u0026#39;D0 D1 D2 D3\u0026#39;},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e],\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    head: {tock: 1},\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    gaps: \u0026#39;( . . 1 . s . 1 s . . 1 s . s . )\u0026#39;,\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    foot: {text: \u0026#39;reads\u0026#39;}\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e}\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"s\"\u003e```\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003eThe rendered output looks like this:\u003c/p\u003e\n\u003cscript type=\"WaveDrom\"\u003e{signal: [\n  {name: 'clock',   wave: 'p................'},\n  {name: 'hwrite',  wave: 'x0x.0x..0.x.0.x..'},\n  {name: 'htrans',  wave: 'x3x.4x..5.x.6.x..', data: '2 2 2 2'},\n  {name: 'haddr',   wave: 'x3x.4x..5.x.6.x..', data: 'A0 A1 A2 A3'},\n  {},\n  {name: 'hready',  wave: 'x1.x101x01.x0101x'},\n  {name: 'hrdata',  wave: 'x.3x..4x..5x...6x', data: 'D0 D1 D2 D3'},\n],\n    head: {tock: 1},\n    gaps: '( . . 1 . s . 1 s . . 1 s . s . )',\n    foot: {text: 'reads'}\n}\u003c/script\u003e",
        "language": "en"
    },
    {
        "title" : "Theme Documentation - Basics",
        "date_published" : "2020-03-06T00:00:00Z",
